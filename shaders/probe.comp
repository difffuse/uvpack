#version 450
// Liveness probe: proves the loader, device, pipeline and memory path work.
// Each invocation writes a value the host recomputes, so a wrong result is a hard
// failure rather than a silently zeroed buffer.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0, std430) writeonly buffer Out { uint values[]; } outBuf;

layout(push_constant) uniform Push {
    uint count;
    uint seed;
} push;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= push.count) return;
    outBuf.values[i] = i * 2654435761u + push.seed;
}
