# Turn a SPIR-V binary into a C++ translation unit holding its bytes.
#   cmake -DSPV=<in.spv> -DOUT=<out.cpp> -DSYMBOL=<identifier> -P embed_spv.cmake
# The generated symbols are declared in include/uvpack/gpu_shaders.hpp.
if(NOT EXISTS "${SPV}")
  message(FATAL_ERROR "embed_spv: missing SPIR-V input ${SPV}")
endif()
file(READ "${SPV}" hex HEX)
string(LENGTH "${hex}" chars)
math(EXPR bytes "${chars} / 2")
if(bytes EQUAL 0)
  message(FATAL_ERROR "embed_spv: empty SPIR-V input ${SPV}")
endif()
set(body "")
set(i 0)
set(column 0)
while(i LESS chars)
  string(SUBSTRING "${hex}" ${i} 2 pair)
  string(APPEND body "0x${pair},")
  math(EXPR column "${column} + 1")
  if(column EQUAL 16)
    string(APPEND body "\n")
    set(column 0)
  endif()
  math(EXPR i "${i} + 2")
endwhile()
file(WRITE "${OUT}" "// Generated by cmake/embed_spv.cmake from ${SPV}. Do not edit.\n"
  "#include <cstddef>\n"
  "namespace uvpack::gpu {\n"
  "extern const unsigned char ${SYMBOL}[] = {\n${body}\n};\n"
  "extern const std::size_t ${SYMBOL}_size = ${bytes};\n"
  "} // namespace uvpack::gpu\n")
